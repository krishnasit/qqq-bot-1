from __future__ import annotations
import argparse, os
from datetime import datetime, timedelta, timezone
import pandas as pd
from dotenv import load_dotenv
from alpaca.data.enums import DataFeed
from alpaca.data.historical.stock import StockHistoricalDataClient
from alpaca.data.requests import StockBarsRequest
from alpaca.data.timeframe import TimeFrame, TimeFrameUnit
from backtester import prepare_strategy_frame, near_ema
from config import StrategyConfig
from patterns import detect_pattern

load_dotenv()

def fetch_bars(symbol, days):
    api_key = os.getenv("ALPACA_API_KEY")
    api_secret = os.getenv("ALPACA_SECRET_KEY")
    if not api_key or not api_secret:
        raise RuntimeError("Missing ALPACA_API_KEY / ALPACA_SECRET_KEY in .env")
    client = StockHistoricalDataClient(api_key, api_secret)
    end = datetime.now(timezone.utc)
    start = end - timedelta(days=days)
    req = StockBarsRequest(symbol_or_symbols=symbol, timeframe=TimeFrame(5, TimeFrameUnit.Minute), start=start, end=end, feed=DataFeed.IEX)
    bars = client.get_stock_bars(req).df
    if isinstance(bars.index, pd.MultiIndex):
        bars = bars.xs(symbol, level=0)
    bars.index = pd.to_datetime(bars.index, utc=True)
    return bars

def run_backtest(df, config, record_trades=False):
    frame = prepare_strategy_frame(df, config)
    capital = float(config.initial_capital)
    equity = capital
    peak = capital
    max_dd = 0.0
    wins = losses = 0
    total_r = 0.0
    gross_win = gross_loss = 0.0
    trade_log = []
    in_position = False
    side = None
    entry = stop = target = None

    for i in range(2, len(frame)):
        row = frame.iloc[i]
        ts = frame.index[i]

        if in_position:
            hit_stop = (side == "long" and row["low"] <= stop) or (side == "short" and row["high"] >= stop)
            hit_target = (side == "long" and row["high"] >= target) or (side == "short" and row["low"] <= target)
            if hit_stop or hit_target:
                exit_price = stop if hit_stop else target
                r_mult = -1.0 if hit_stop else float(config.rr_target)
                risk_amt = capital * 0.01
                pnl = risk_amt * r_mult
                equity += pnl
                gross_win += max(pnl, 0)
                gross_loss += abs(min(pnl, 0))
                total_r += r_mult
                if pnl > 0: wins += 1
                else: losses += 1
                peak = max(peak, equity)
                dd = (peak - equity) / peak * 100 if peak > 0 else 0
                max_dd = max(max_dd, dd)
                if record_trades:
                    trade_log.append({"entry_time": entry_ts, "side": side, "entry_price": round(entry,4), "exit_price": round(exit_price,4), "stop_price": round(stop,4), "target_price": round(target,4), "r_multiple": r_mult, "pnl_usd": round(pnl,2), "result": "WIN" if pnl>0 else "LOSS", "equity": round(equity,2), "drawdown_pct": round(dd,2)})
                in_position = False
            continue

        if not bool(row.get("after_buffer", False)):
            continue
        bias = row.get("bias")
        if pd.isna(bias) or bias is None:
            continue
        if not near_ema(row, config.ema_confluence_pct):
            continue
        pattern = detect_pattern(frame, i, bias, config.enabled_patterns)
        if not pattern:
            continue
        if pd.isna(row.get("atr")):
            continue

        entry_price = float(row["close"])
        atr_buffer = float(row["atr"]) * float(config.atr_stop_buffer_mult)
        min_buffer = max(0.05, entry_price * 0.0005)
        effective_buffer = max(atr_buffer, min_buffer)

        if bias == "long":
            stop_price = float(row["low"]) - effective_buffer
            target_price = entry_price + (entry_price - stop_price) * float(config.rr_target)
        else:
            stop_price = float(row["high"]) + effective_buffer
            target_price = entry_price - (stop_price - entry_price) * float(config.rr_target)

        risk = abs(entry_price - stop_price)
        if risk <= 0 or stop_price <= 0 or target_price <= 0:
            continue

        in_position = True
        side = bias
        entry = entry_price
        stop = stop_price
        target = target_price
        entry_ts = ts

    total_trades = wins + losses
    win_rate = (wins / total_trades * 100) if total_trades else 0
    profit_factor = (gross_win / gross_loss) if gross_loss > 0 else float("inf")
    avg_rr = (total_r / total_trades) if total_trades else 0
    net_pnl = equity - capital
    return_pct = (net_pnl / capital * 100) if capital else 0

    stats = {
        "total_trades": total_trades, "wins": wins, "losses": losses,
        "win_rate_pct": round(win_rate, 2), "profit_factor": round(profit_factor, 3),
        "avg_rr": round(avg_rr, 3), "total_r": round(total_r, 2),
        "max_dd_pct": round(max_dd, 2), "net_pnl": round(net_pnl, 2),
        "return_pct": round(return_pct, 2), "final_equity": round(equity, 2),
    }
    return stats, trade_log

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--symbol", default="QQQ")
    ap.add_argument("--days", type=int, default=365)
    ap.add_argument("--capital", type=float, default=10000)
    args = ap.parse_args()

    print(f"Fetching {args.days}d of 5-min bars for {args.symbol}...")
    df = fetch_bars(args.symbol, args.days)
    print(f"Got {len(df)} bars.\n")

    cfg = StrategyConfig()
    cfg.symbol = args.symbol; cfg.enabled_patterns = ["engulfing"]; cfg.no_trade_buffer_minutes = 60
    cfg.initial_capital = args.capital

    stats, trade_log = run_backtest(df, cfg, record_trades=True)
    pd.DataFrame(trade_log).to_csv("single_backtest_trades.csv", index=False)

    print(f"{'#':<5}{'Entry Time':<22}{'Side':<7}{'Entry':<9}{'Exit':<9}{'Stop':<9}{'Target':<9}{'R':<7}{'PnL $':<10}{'Result':<7}{'Equity':<12}{'DD%'}")
    print("-"*115)
    for i, t in enumerate(trade_log, 1):
        print(f"{i:<5}{str(t['entry_time'])[:19]:<22}{t['side']:<7}{t['entry_price']:<9}{t['exit_price']:<9}{t['stop_price']:<9}{t['target_price']:<9}{t['r_multiple']:<7}{t['pnl_usd']:<10}{t['result']:<7}{t['equity']:<12}{t['drawdown_pct']}")

    print(f"\n{'='*60}\nSTRATEGY STATS ({args.days}d, using current config with min-stop fix)\n{'='*60}")
    for k, v in stats.items():
        print(f"  {k:<22}: {v}")

    print("\nCONFIG USED:")
    for c in ["entry_ema_length","trend_sma_length","ema_confluence_pct","atr_length","atr_stop_buffer_mult","rr_target","no_trade_buffer_minutes","enabled_patterns"]:
        print(f"  {c:<28}: {getattr(cfg, c)}")

if __name__ == "__main__":
    main()
